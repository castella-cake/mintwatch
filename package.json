{
  "name": "mintwatch",
  "description": "ニコニコ動画用のカスタマイズ可能な動画プレイヤー",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/castella-cake/mintwatch#readme",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint:script": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:style": "stylelint {entrypoints,components}/**/*.css",
    "postinstall": "wxt prepare && lefthook install",
    "e2e": "playwright test",
    "test": "vitest"
  },
  "dependencies": {
    "@discordapp/perceptual": "^1.1.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "@types/cloudflare-turnstile": "^0.2.2",
    "@xpadev-net/niconicomments": "^0.4.1",
    "dompurify": "^3.4.17",
    "fastest-levenshtein": "^1.0.16",
    "history": "^5.3.0",
    "hls.js": "^1.7.3",
    "html-react-parser": "6.1.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-focus-lock": "2.13.7",
    "react-markdown": "^10.1.0",
    "react-scan": "^0.5.7",
    "react-transition-group": "^4.4.5",
    "react-transition-state": "^2.4.1",
    "remark-gfm": "^4.0.1",
    "sanitize.css": "^13.0.0",
    "virtua": "^0.53.6"
  },
  "devDependencies": {
    "@csstools/postcss-minify": "^3.0.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/chrome": "^0.3.6",
    "@types/jquery": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "postcss-nested": "^9.0.1",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
